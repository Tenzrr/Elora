classDiagram
direction TB

class User {
  +id
  +name
}
class Plant {
  +id
  +crop
  +nickname
}
class AgentThread {
  +id
  +title
  +updatedAt
}
class AgentMessage {
  +sender
  +content
  +createdAt
}
class AgentToolRun {
  +toolName
  +durationMs
  +createdAt
}
class AgentMemory {
  +category
  +crop
  +content
}
class AssistantService {
  +sendMessage(AgentThread)
  +validateReply(String)
}
class AgentWorkflow {
  +classifyIntent(String)
  +synthesizeReply()
}
class BackendTool {
  <<interface>>
  +execute(Input)
}
class KnowledgeRetriever {
  +search(String)
  +rankSources(List)
}

User "1" --> "0..*" AgentThread : starts
Plant "0..1" --> "0..*" AgentThread : provides context
AgentThread "1" *-- "1..*" AgentMessage : contains
AgentThread "1" *-- "0..*" AgentToolRun : records
AssistantService ..> AgentWorkflow : coordinates
AgentWorkflow ..> BackendTool : invokes
AgentWorkflow ..> KnowledgeRetriever : retrieves context
KnowledgeRetriever ..> AgentMemory : searches
BackendTool ..> Plant : reads plant history
