{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elora.invalid/schemas/model-result-v2.json",
  "title": "Elora shared assessment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scan_id",
    "crop_slug",
    "task",
    "model_id",
    "model_version",
    "origin",
    "outcome",
    "assessed_at",
    "label_id",
    "confidence",
    "top_predictions",
    "warnings",
    "guidance"
  ],
  "properties": {
    "scan_id": {
      "type": "string",
      "format": "uuid"
    },
    "crop_slug": {
      "enum": [
        "tomato",
        "chilli",
        "citrus",
        "banana",
        "roses",
        "chrysanthemum"
      ]
    },
    "task": {
      "enum": [
        "disease",
        "quality"
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "server",
        "on_device"
      ]
    },
    "outcome": {
      "enum": [
        "assessed",
        "unable_to_assess"
      ]
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "label_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "top_predictions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label_id",
          "confidence"
        ],
        "properties": {
          "label_id": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source_url"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "assessed"
          }
        }
      },
      "then": {
        "properties": {
          "label_id": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "unable_to_assess"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "label_id": {
            "type": "null"
          },
          "confidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "const": "on_device"
          }
        }
      },
      "then": {
        "properties": {
          "task": {
            "const": "disease"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "assessed"
          },
          "task": {
            "const": "disease"
          }
        }
      },
      "then": {
        "properties": {
          "confidence": {
            "minimum": 0.6
          }
        }
      }
    }
  ]
}
