# Runtime template. Ordinary developers receive only their scoped workspace credentials.
APP_ENV=development
DATABASE_SCHEMA=dev1
DATABASE_REQUIRE_TLS=true
# DATABASE_URL=postgresql+asyncpg://elora_dev1_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
FIREBASE_PROJECT_ID=elora-dev-9f6b9
