# Coordinator-only template. Copy to .env.coordinator (ignored by Git).
APP_ENV=development
SUPABASE_PROJECT_REF=idptcxheihiakwttvkgo
# Copy Connect > Session pooler, port 5432. Percent-encode the password in the URL.
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres.idptcxheihiakwttvkgo:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_SESSION_POOLER_HOST:5432/postgres
# Used only when the coordinator runs Alembic, never by the API runtime.
DATABASE_SCHEMA=integration
DATABASE_REQUIRE_TLS=true
FIREBASE_PROJECT_ID=elora-dev-9f6b9
GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-admin.json
